{
  "name": "@reservaitn/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:pull": "prisma db pull && prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/client": "5.22.0",
    "@reservaitn/shared": "workspace:*",
    "bcryptjs": "2.4.3",
    "exceljs": "4.4.0",
    "nodemailer": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/mailparser": "3.4.5",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.10",
    "mailparser": "3.7.2",
    "prisma": "5.22.0",
    "smtp-server": "3.13.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
