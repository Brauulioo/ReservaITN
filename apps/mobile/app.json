{
  "expo": {
    "name": "ReservaITN",
    "slug": "reservaitn",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "cl.itn.reservaitn",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "ReservaITN usa la cámara para leer el código QR de la sala al hacer check-in y para fotografiar daños."
      }
    },
    "android": {
      "package": "cl.itn.reservaitn",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 4
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "ReservaITN usa la cámara solo para leer el código QR de la sala al hacer check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ReservaITN usa la cámara para tomar la foto de un daño y adjuntarla al reporte.",
          "photosPermission": "ReservaITN accede a tus fotos solo para adjuntar la imagen de un daño al reporte.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "owner": "brauulioo",
    "extra": {
      "eas": {
        "projectId": "f8c5e319-72a5-454b-9702-ccfc382717e5"
      }
    }
  }
}
