# Dirección de la API que usa la app.
#
# Opción 1 · La API en la nube (Render): funciona desde cualquier red, wifi o datos móviles.
#   La primera petición del día puede tardar cerca de un minuto mientras la API despierta.
EXPO_PUBLIC_API_URL=https://reservaitn-api-v2.onrender.com/api
#
# Opción 2 · La API en tu computador: el celular debe estar en la misma red WiFi.
#   Usa la IP del computador (Windows: ipconfig → "Dirección IPv4"; Mac: ipconfig getifaddr en0),
#   nunca "localhost" (sería el propio celular).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
